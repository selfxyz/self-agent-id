# ── Core ─────────────────────────────────────────────────────────────────

# Encryption key for session tokens (AES-256-GCM). Required by every
# register / deregister / identify / refresh endpoint and the MCP
# registration tools. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL of this deployment. Used for every link handed to clients
# (e.g. `scanUrl`, discovery documents). Never derived from Host/X-Forwarded-Host;
# defaults to https://agent-api.self.xyz in production.
# NEXT_PUBLIC_APP_URL=https://agent-api.self.xyz

# Default network for routes that don't take one (celo-mainnet | celo-sepolia).
# NEXT_PUBLIC_DEFAULT_NETWORK=celo-mainnet

# Self app display name and scope seed. They must match what the registry
# contract was configured with; /cli/register only accepts these exact values.
# NEXT_PUBLIC_SELF_APP_NAME=Self Agent ID
# NEXT_PUBLIC_SELF_SCOPE_SEED=self-agent-id

# Private RPC URLs (optional — falls back to public Forno endpoints).
# Set these to avoid rate limits under traffic.
# NEXT_PUBLIC_RPC_CELO=https://celo-mainnet.infura.io/v3/YOUR_KEY
# NEXT_PUBLIC_RPC_CELO_SEPOLIA=https://celo-sepolia.infura.io/v3/YOUR_KEY

# NOTE: Contract addresses are hardcoded in lib/network.ts.
# Update that file directly on contract redeploy — no env vars needed.

# ── Shared rate-limit / replay store ─────────────────────────────────────

# Upstash Redis REST credentials. Without them, rate limits and the visa
# signature replay guard are per serverless instance only. (MCP
# self_verify_request keeps its replay cache in memory regardless.)
# Strongly recommended in production.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Celo Agent Visa ──────────────────────────────────────────────────────

# Relayer key holding MINTER_ROLE / METRICS_UPDATER_ROLE on the visa contract.
# Used only by the signed POST /api/visa/{claim,migrate,request-review}
# routes; unset → those routes return 503 after authenticating the caller.
RELAYER_PRIVATE_KEY=

# ── MCP Server (/api/mcp) ────────────────────────────────────────────────

# Bearer keys that unlock privileged MCP tools (self_get_identity,
# self_deregister_agent, self_sign_request, self_authenticated_fetch).
# Comma-separated list, or a single key. Unset → no privileged access.
# MCP_PRIVILEGED_API_KEYS=key1,key2
# MCP_PRIVILEGED_API_KEY=

# Agent private key used by the privileged MCP tools.
# INTENTIONALLY UNSET on shared deployments — only set for private/single-user
# deployments together with MCP_PRIVILEGED_API_KEY(S).
# SELF_AGENT_PRIVATE_KEY=

# Network for the MCP agent identity: "testnet", anything else = mainnet.
# SELF_AGENT_NETWORK=mainnet

# RPC override for SELF_AGENT_NETWORK only (defaults to the SDK's Forno URL).
# SELF_RPC_URL=

# MCP tools call this deployment's REST handlers in-process. Set this only to
# point them at another deployment over HTTP instead.
# SELF_AGENT_API_BASE=

# Optional: restrict self_authenticated_fetch egress to specific hosts.
# Comma-separated hostnames; supports wildcard subdomain entries like "*.example.com".
# If unset, any public host is allowed.
# MCP_AUTH_FETCH_ALLOWED_HOSTS=api.example.com,*.trusted.example

# self_authenticated_fetch blocks localhost/private/reserved targets (SSRF).
# Set to true only in controlled development environments.
# MCP_AUTH_FETCH_ALLOW_PRIVATE_NETWORKS=false

# Replay protection for self_verify_request (enabled by default).
# MCP_VERIFY_REQUEST_REPLAY_PROTECTION=true
